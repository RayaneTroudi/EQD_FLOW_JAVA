@startuml ARCHI
interface Instrument {
  +getUnderlying()
  +getStrike()
  +getMaturity()
}

class VanillaOption {
  -strike: double
  -maturity: LocalDate
  -isCall: boolean
  -id: String
  -underlying: String
}

class OptionQuoteRow {
  -underlyingLast: double
  -strike: double
  -expireDate: LocalDate
  -callIV: double
  -putIV: double
  -callBid: double
  -callAsk: double
  -putBid: double
  -putAsk: double
  -callVolume: double
  -putVolume: double
}

class MarketData {
  +
}

interface MarketDataSource {
    +MarketData load(LocalDate date)
}

class MarketDataParquet {
  -filePath : String
  -assumptions : MarketDataAssumptions
}

class MarketDataAssumptions {
  -double : riskFreeRate
  -double : dividendYield
}

class ImpliedSurfaceVol{

}


MarketDataParquet ..> OptionQuoteRow : uses
VanillaOption ..|> Instrument : implements
MarketDataSource ..> MarketData : produces
MarketDataAssumptions <-- MarketData  : uses
MarketDataParquet ..|>  MarketDataSource 
@enduml